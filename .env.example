# Site
NEXT_PUBLIC_SITE_URL=https://arpitwedsmuskan.netlify.app

# Direct Postgres for RSVP (server only — required on Netlify)
# Prefer Supabase "Transaction pooler" (IPv4). Direct db.* hosts are often IPv6-only
# and fail on Netlify Functions.
# URL-encode special characters in the password (@ -> %40, $ -> %24)
# Example:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.thjlehavxekwefkixagf:Wedding@04122026$$@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Supabase API (needed for /admin login)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI Gateway (Ask Arpit & Muskan) — optional
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=openai/gpt-4o-mini
